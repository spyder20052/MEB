# Stack Supabase self-hostée pour la prod MEB (db + auth + rest + realtime + storage + envoy).
# Basé sur https://github.com/supabase/supabase/blob/master/docker/.env.example, élagué des
# services non utilisés par le projet (functions, supavisor, logflare/vector, minio).
#
# Copier en `.env` sur le serveur (jamais commité) et remplir toutes les valeurs.
# Génération : voir le README de ce dossier ou demander à l'assistant de régénérer un jeu de secrets.

COMPOSE_FILE=docker-compose.yml

############
# Secrets — À CHANGER AVANT LE PREMIER DÉMARRAGE
############

POSTGRES_PASSWORD=
# Au moins 32 caractères — openssl rand -base64 48
JWT_SECRET=
# JWT HS256 signé avec JWT_SECRET, role=anon
ANON_KEY=
# JWT HS256 signé avec JWT_SECRET, role=service_role — ne JAMAIS exposer côté client
SERVICE_ROLE_KEY=

DASHBOARD_USERNAME=meb-admin
DASHBOARD_PASSWORD=

# Au moins 64 caractères — openssl rand -base64 48
SECRET_KEY_BASE=
# Exactement 16 caractères — openssl rand -hex 8
REALTIME_DB_ENC_KEY=
# Exactement 32 caractères — openssl rand -hex 16
VAULT_ENC_KEY=
# Au moins 32 caractères — openssl rand -base64 24
PG_META_CRYPTO_KEY=

# Non utilisé par l'appli (pas de client S3), mais requis par storage-api
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

############
# URLs — domaines réels du site
############

# URL publique de la passerelle API (Envoy), reverse-proxyée par Nginx en HTTPS
SUPABASE_PUBLIC_URL=https://api.entrepreneurbenin.pro
API_EXTERNAL_URL=https://api.entrepreneurbenin.pro/auth/v1

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Studio (accessible uniquement via tunnel SSH, jamais exposé publiquement)
############

STUDIO_DEFAULT_ORGANIZATION=MEB
STUDIO_DEFAULT_PROJECT=Maison de l'Entrepreneur du Bénin
OPENAI_API_KEY=

############
# Auth
############

SITE_URL=https://entrepreneurbenin.pro
ADDITIONAL_REDIRECT_URLS=https://entrepreneurbenin.pro/dashboard/definir-mot-de-passe

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
# Mirroir de auth.email.enable_confirmations=false dans supabase/config.toml (dev)
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Mêmes identifiants SMTP que le site (voir .env.production à la racine du repo)
SMTP_ADMIN_EMAIL=contact@entrepreneurbenin.pro
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME="Maison de l'Entrepreneur du Bénin"

############
# Storage
############

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=meb

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Passerelle API (Envoy)
############

# 8000 déjà pris sur le VPS mutualisé (autre projet) — la passerelle Supabase MEB écoute sur 8010
API_GW_HTTP_PORT=8010
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true

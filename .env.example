# ============================================================
# MEB — Variables d'environnement
# Copier ce fichier en .env.local puis remplir les valeurs.
# ============================================================

# --- Supabase ---
# En local : `npx supabase start` affiche l'URL et les clés.
# En production : projet Supabase hébergé (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement — ne JAMAIS exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mails (SMTP) ---
# En dev : MailHog (docker compose up -d) — interface sur http://localhost:8025
# En prod : SMTP Resend (smtp.resend.com:465, user "resend", pass = clé API)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Adresse qui reçoit les demandes (RDV, inscriptions) — à confirmer avec la MEB.
CONTACT_EMAIL_TO=contact@entrepreneurbenin.pro
# Expéditeur des e-mails transactionnels (domaine vérifié chez le fournisseur SMTP).
CONTACT_EMAIL_FROM="Maison de l'Entrepreneur du Bénin <no-reply@entrepreneurbenin.pro>"

# --- Site ---
# URL publique du site (liens dans les e-mails : invitation admin, désinscription).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
